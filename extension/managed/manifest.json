{
  "manifest_version": 3,
  "name": "HoanXu GPM · Bộ chạy extension",
  "version": "1.0.0",
  "key": "",
  "permissions": [
    "storage",
    "scripting",
    "debugger",
    "alarms",
    "tabs"
  ],
  "host_permissions": [
    "https://www.threads.com/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "managed-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "managed-popup.html",
    "default_title": "HoanXu GPM · chạy bằng extension"
  }
}
